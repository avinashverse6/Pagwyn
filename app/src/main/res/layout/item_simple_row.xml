<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_2"
    android:paddingEnd="@dimen/space_2"
    android:paddingBottom="@dimen/space_2">

    <ImageView
        android:id="@+id/rowIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_pdf_doc"
        android:tint="?attr/pwOnSurfaceMuted" />

    <TextView
        android:id="@+id/rowTitle"
        style="@style/Text.Pagwyn.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_4"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1" />

    <TextView
        android:id="@+id/rowValue"
        style="@style/Text.Pagwyn.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_2" />

    <ImageButton
        android:id="@+id/rowAction"
        style="@style/Widget.Pagwyn.IconButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/action_remove"
        android:padding="10dp"
        android:src="@drawable/ic_close"
        android:visibility="gone" />
</LinearLayout>
