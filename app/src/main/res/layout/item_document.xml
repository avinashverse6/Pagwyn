<?xml version="1.0" encoding="utf-8"?>
<!--
  A document row. Deliberately information-dense without being noisy: title,
  reading position, and three secondary facts (pages, size, location).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_2"
    android:paddingTop="@dimen/space_2"
    android:paddingEnd="@dimen/space_2"
    android:paddingBottom="@dimen/space_2">

    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_doc_thumb">

        <ImageView
            android:id="@+id/docThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="3dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/docFallbackIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_pdf_doc"
            android:tint="?attr/pwOnSurfaceMuted" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/docTitle"
            style="@style/Text.Pagwyn.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Deep Work" />

        <TextView
            android:id="@+id/docMeta"
            style="@style/Text.Pagwyn.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="12sp"
            tools:text="296 pages · 4.2 MB · Downloads" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/docProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressDrawable="@drawable/bg_progress_track" />

            <TextView
                android:id="@+id/docPosition"
                style="@style/Text.Pagwyn.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:textSize="11sp"
                tools:text="p. 128" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/docStar"
        style="@style/Widget.Pagwyn.IconButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/action_star"
        android:padding="10dp"
        android:src="@drawable/ic_star" />
</LinearLayout>
