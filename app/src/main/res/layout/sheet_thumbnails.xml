<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pwSurface"
    android:orientation="vertical">

    <include layout="@layout/view_sheet_header" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/thumbnailList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/space_3"
        android:paddingEnd="@dimen/space_3"
        android:paddingBottom="@dimen/space_6"
        android:scrollbars="none" />
</LinearLayout>
