<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pwSurface"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_8">

        <!-- ============================ Brand header ============================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/space_2"
            android:paddingBottom="@dimen/space_2">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_pagwyn_mark"
                android:tint="?attr/pwOnSurface" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.02"
                    android:text="@string/app_name"
                    android:textColor="?attr/pwOnSurface"
                    android:textSize="22sp" />

                <TextView
                    style="@style/Text.Pagwyn.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_tagline"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSettings"
                style="@style/Widget.Pagwyn.IconButton"
                android:contentDescription="@string/home_settings"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <!-- ============================ Search + browse ============================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_3"
            android:paddingEnd="@dimen/screen_margin">

            <LinearLayout
                android:id="@+id/searchFieldContainer"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_4"
                android:paddingEnd="@dimen/space_4">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    android:tint="?attr/pwOnSurfaceMuted" />

                <EditText
                    android:id="@+id/searchField"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/home_search_hint"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="@dimen/space_3"
                    android:paddingEnd="@dimen/space_2"
                    android:textColor="?attr/pwOnSurface"
                    android:textColorHint="?attr/pwOnSurfaceMuted"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/searchClear"
                    style="@style/Widget.Pagwyn.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/action_clear"
                    android:padding="8dp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnBrowse"
                style="@style/Widget.Pagwyn.IconButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="@dimen/space_2"
                android:background="@drawable/bg_button_primary"
                android:contentDescription="@string/cd_open_document"
                android:padding="14dp"
                android:src="@drawable/ic_folder_open"
                android:tint="?attr/pwOnPrimary" />
        </LinearLayout>

        <!-- ============================ Continue reading ============================ -->
        <include
            android:id="@+id/continueCard"
            layout="@layout/view_continue_reading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_5"
            android:layout_marginEnd="@dimen/screen_margin" />

        <!-- ============================ Recent list ============================ -->
        <LinearLayout
            android:id="@+id/recentHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_6"
            android:paddingEnd="@dimen/screen_margin">

            <TextView
                style="@style/Text.Pagwyn.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_recent" />

            <TextView
                android:id="@+id/recentSeeAll"
                style="@style/Text.Pagwyn.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/space_1"
                android:text="@string/home_see_all"
                android:textColor="?attr/pwPrimary" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recentList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/space_3"
            android:paddingEnd="@dimen/space_3"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/recentEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_8"
            android:paddingTop="@dimen/space_6"
            android:paddingEnd="@dimen/space_8"
            android:paddingBottom="@dimen/space_6"
            android:visibility="gone">

            <TextView
                style="@style/Text.Pagwyn.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_recent_empty" />

            <TextView
                style="@style/Text.Pagwyn.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/home_recent_empty_body" />
        </LinearLayout>

        <!-- ============================ Starred ============================ -->
        <LinearLayout
            android:id="@+id/starredHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_6"
            android:paddingEnd="@dimen/screen_margin"></LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/starredList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/space_3"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/space_3"
            android:scrollbars="none" />

        <!-- ============================ Search results ============================ -->
        <LinearLayout
            android:id="@+id/searchResultsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_5"
            android:paddingEnd="@dimen/screen_margin"
            android:visibility="gone">

            <TextView
                style="@style/Text.Pagwyn.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_search" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/searchResultsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/space_3"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/space_3"
            android:scrollbars="none"
            android:visibility="gone" />

        <TextView
            android:id="@+id/searchNoMatch"
            style="@style/Text.Pagwyn.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_8"
            android:gravity="center"
            android:visibility="gone"
            tools:text="No documents match “draft”" />

        <!-- ============================ Footer ============================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/screen_margin">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_offline"
                android:tint="?attr/pwOnSurfaceMuted" />

            <TextView
                style="@style/Text.Pagwyn.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:text="@string/home_privacy_note"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/versionLabel"
            style="@style/Text.Pagwyn.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="center"
            android:textSize="11sp"
            tools:text="Pagwyn 1.0.0" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
