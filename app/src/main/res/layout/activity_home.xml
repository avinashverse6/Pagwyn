<?xml version="1.0" encoding="utf-8"?>
<!--
  Library. Dark-first, Notion-clean: a quiet brand row, a pill search field, a
  Spotify-style hero card, then a two-column grid of rounded cards.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pwSurface"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_10">

        <!-- ============================ Brand header ============================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_3"
            android:paddingEnd="@dimen/space_2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/brandGreeting"
                    style="@style/Text.Pagwyn.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.03"
                    android:text="@string/home_greeting"
                    android:textSize="30sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSettings"
                style="@style/Widget.Pagwyn.IconButton"
                android:contentDescription="@string/home_settings"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <!-- ============================ Search ============================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/screen_margin">

            <LinearLayout
                android:id="@+id/searchFieldContainer"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_search_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_4"
                android:paddingEnd="@dimen/space_2">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    android:tint="?attr/pwOnSurfaceMuted" />

                <EditText
                    android:id="@+id/searchField"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/home_search_hint"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="@dimen/space_3"
                    android:paddingEnd="@dimen/space_2"
                    android:textColor="?attr/pwOnSurface"
                    android:textColorHint="?attr/pwOnSurfaceMuted"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/searchClear"
                    style="@style/Widget.Pagwyn.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/action_clear"
                    android:padding="10dp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================ Filter chips ============================ -->
        <HorizontalScrollView
            android:id="@+id/filterScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/screen_margin"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipAll"
                    style="@style/Widget.Pagwyn.Chip"
                    android:text="@string/filter_all" />

                <TextView
                    android:id="@+id/chipStarred"
                    style="@style/Widget.Pagwyn.Chip"
                    android:layout_marginStart="@dimen/space_2"
                    android:text="@string/filter_starred" />

                <TextView
                    android:id="@+id/chipRecent"
                    style="@style/Widget.Pagwyn.Chip"
                    android:layout_marginStart="@dimen/space_2"
                    android:text="@string/filter_recent" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ======================= Continue reading (hero) ======================= -->
        <LinearLayout
            android:id="@+id/continueCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_5"
            android:layout_marginEnd="@dimen/screen_margin"
            android:background="@drawable/bg_hero_card"
            android:orientation="vertical"
            android:padding="@dimen/space_4"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/continueCover"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/continueKicker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.85"
                        android:letterSpacing="0.14"
                        android:text="@string/home_continue_kicker"
                        android:textAllCaps="true"
                        android:textColor="#FFFFFFFF"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/continueTitle"
                        style="@style/Text.Pagwyn.HeroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        tools:text="Deep Work" />

                    <TextView
                        android:id="@+id/continueMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.9"
                        android:maxLines="1"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp"
                        tools:text="Page 42 of 380" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="#FFFFFFFF" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/continueProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="@dimen/space_4"
                android:max="1000"
                android:progressDrawable="@drawable/bg_progress_hero" />
        </LinearLayout>

        <!-- ============================ Library grid ============================ -->
        <LinearLayout
            android:id="@+id/libraryHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_6"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_3">

            <TextView
                android:id="@+id/libraryTitle"
                style="@style/Text.Pagwyn.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_your_library" />

            <TextView
                android:id="@+id/btnBrowse"
                style="@style/Text.Pagwyn.Label"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="?attr/pwPrimaryMuted"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="@dimen/space_4"
                android:paddingEnd="@dimen/space_4"
                android:text="@string/home_browse"
                android:textColor="?attr/pwPrimary" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/libraryGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:scrollbars="none"
            tools:itemCount="4"
            tools:listitem="@layout/item_document_card" />

        <!-- Search results, shown instead of the grid while searching. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/searchResultsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:scrollbars="none"
            android:visibility="gone"
            tools:itemCount="2"
            tools:listitem="@layout/item_document_row" />

        <TextView
            android:id="@+id/searchNoMatch"
            style="@style/Text.Pagwyn.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/space_8"
            android:visibility="gone" />

        <!-- ============================ Empty state ============================ -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_8"
            android:paddingTop="@dimen/space_10"
            android:paddingEnd="@dimen/space_8"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_empty_badge">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_empty_library"
                    android:tint="?attr/pwPrimary" />
            </FrameLayout>

            <TextView
                style="@style/Text.Pagwyn.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:text="@string/home_empty_title" />

            <TextView
                style="@style/Text.Pagwyn.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="center"
                android:lineSpacingMultiplier="1.35"
                android:text="@string/home_empty_body" />

            <Button
                android:id="@+id/btnEmptyAdd"
                style="@style/Widget.Pagwyn.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/space_5"
                android:text="@string/home_pick_document" />
        </LinearLayout>

        <TextView
            android:id="@+id/versionLabel"
            style="@style/Text.Pagwyn.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:gravity="center"
            android:paddingTop="@dimen/space_6"
            android:textSize="11sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
