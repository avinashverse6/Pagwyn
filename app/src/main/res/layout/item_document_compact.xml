<?xml version="1.0" encoding="utf-8"?>
<!-- Compact card used for the "starred" rail and search results. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="188dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="@dimen/space_3">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="@drawable/bg_doc_thumb">

        <ImageView
            android:id="@+id/docThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="3dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/docFallbackIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_pdf_doc"
            android:tint="?attr/pwOnSurfaceMuted" />

        <ImageView
            android:id="@+id/docStarBadge"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_star_filled"
            android:tint="?attr/pwPrimary" />
    </FrameLayout>

    <TextView
        android:id="@+id/docTitle"
        style="@style/Text.Pagwyn.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="13sp"
        tools:text="Thinking, Fast and Slow" />

    <TextView
        android:id="@+id/docMeta"
        style="@style/Text.Pagwyn.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="11sp"
        tools:text="p. 42 of 499" />

    <ProgressBar
        android:id="@+id/docProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="@dimen/space_2"
        android:max="1000"
        android:progressDrawable="@drawable/bg_progress_track" />
</LinearLayout>
