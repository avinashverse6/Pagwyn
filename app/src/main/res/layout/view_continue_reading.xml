<?xml version="1.0" encoding="utf-8"?>
<!--
  "Continue reading" card: the single most likely action on the home screen, so it
  is the largest and most prominent element. Shows real progress, not a percentage
  the user has to interpret.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/continueRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_primary"
    android:orientation="vertical"
    android:padding="@dimen/space_4">

    <TextView
        style="@style/Text.Pagwyn.Section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_continue_reading"
        android:textColor="?attr/pwPrimaryMuted" />

    <TextView
        android:id="@+id/continueTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:textColor="?attr/pwOnPrimary"
        android:textSize="19sp"
        tools:text="Deep Work — Cal Newport" />

    <TextView
        android:id="@+id/continueMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/pwPrimaryMuted"
        android:textSize="13sp"
        tools:text="Resume page 128 of 296" />

    <ProgressBar
        android:id="@+id/continueProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="@dimen/space_3"
        android:max="1000"
        android:progressDrawable="@drawable/bg_progress_on_accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/continuePercent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/pwPrimaryMuted"
            android:textSize="12sp"
            tools:text="43% read" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_on_accent"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="@dimen/space_4"
            android:paddingTop="@dimen/space_1"
            android:paddingEnd="@dimen/space_4"
            android:paddingBottom="@dimen/space_1"
            android:text="@string/action_open"
            android:textColor="?attr/pwOnPrimary"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
