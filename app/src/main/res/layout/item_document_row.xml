<?xml version="1.0" encoding="utf-8"?>
<!-- Search result: a clean Notion-style row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_marginBottom="@dimen/space_2"
    android:minHeight="72dp"
    android:padding="@dimen/space_3">

    <ImageView
        android:id="@+id/rowCover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            style="@style/Text.Pagwyn.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/pwOnSurface"
            android:textSize="15sp"
            tools:text="Physics notes" />

        <TextView
            android:id="@+id/rowMeta"
            style="@style/Text.Pagwyn.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="12sp"
            tools:text="12 pages · 725 KB" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/rowStar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_star"
        android:padding="12dp"
        android:src="@drawable/ic_star" />
</LinearLayout>
