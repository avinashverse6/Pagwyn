<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pwSurface"
    android:orientation="vertical">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="@dimen/space_3"
        android:background="@drawable/bg_drag_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:background="@drawable/bg_search_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_3"
        android:paddingEnd="@dimen/space_1">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            android:tint="?attr/pwOnSurfaceMuted" />

        <EditText
            android:id="@+id/searchField"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/reader_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="@dimen/space_3"
            android:paddingEnd="@dimen/space_2"
            android:textColor="?attr/pwOnSurface"
            android:textColorHint="?attr/pwOnSurfaceMuted"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/searchProgress"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="@dimen/space_2"
            android:indeterminateTint="?attr/pwPrimary"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/searchClear"
            style="@style/Widget.Pagwyn.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/action_clear"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/searchCount"
        style="@style/Text.Pagwyn.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_3"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_1" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/searchResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_6"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/searchEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_8">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:alpha="0.5"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                android:tint="?attr/pwOnSurfaceMuted" />

            <TextView
                android:id="@+id/searchEmptyLabel"
                style="@style/Text.Pagwyn.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:gravity="center"
                android:text="@string/reader_no_results" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
