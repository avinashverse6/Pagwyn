<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_target"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_3"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_3">

    <TextView
        android:id="@+id/tocTitle"
        style="@style/Text.Pagwyn.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2" />

    <TextView
        android:id="@+id/tocPage"
        style="@style/Text.Pagwyn.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:background="@drawable/bg_badge"
        android:paddingStart="@dimen/space_2"
        android:paddingTop="2dp"
        android:paddingEnd="@dimen/space_2"
        android:paddingBottom="2dp" />
</LinearLayout>
