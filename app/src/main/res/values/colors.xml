<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Pagwyn palette — dark first.

      Surfaces are near-black rather than pure black so elevation reads as light
      rather than as a seam; the OLED variant replaces them with true black. There is
      exactly ONE accent (lime) plus a violet used only for the gradient on the
      continue-reading cover, so the app never looks like an office tool.
    -->

    <!-- Near-black surfaces (dark theme) -->
    <color name="ink_950">#FF0F0F12</color>
    <color name="ink_900">#FF17171C</color>
    <color name="ink_850">#FF1E1E25</color>
    <color name="ink_800">#FF23232C</color>
    <color name="ink_700">#FF2E2E39</color>
    <color name="ink_600">#FF3D3D4B</color>

    <!-- Warm off-white surfaces (light theme) -->
    <color name="paper_050">#FFFFFDF8</color>
    <color name="paper_100">#FFF9F5EC</color>
    <color name="paper_200">#FFF2ECE0</color>
    <color name="paper_300">#FFE6DECD</color>
    <color name="paper_400">#FFD3C9B5</color>

    <!-- Accent: lime. One accent, used for progress, selection and primary actions. -->
    <color name="lime_600">#FF6E9B05</color>
    <color name="lime_500">#FF8FC313</color>
    <color name="lime_400">#FFB4E637</color>
    <color name="lime_300">#FFD2F574</color>
    <color name="lime_100">#FFEBFBC4</color>

    <!-- Violet: only for the generated gradient cover on the hero card. -->
    <color name="violet_600">#FF6D46E8</color>
    <color name="violet_500">#FF8B62F5</color>

    <!-- Text -->
    <color name="ink_text">#FF15151A</color>
    <color name="ink_text_muted">#FF64646F</color>
    <color name="paper_text">#FFF4F2ED</color>
    <color name="paper_text_muted">#FF9B9BA6</color>
    <color name="danger_light">#FFC1301F</color>
    <color name="danger_dark">#FFF4A6A0</color>

    <!-- Reading surfaces. The page sits on this; PDF pixels are never tinted. -->
    <color name="reader_light">#FFF2ECE0</color>
    <color name="reader_dark">#FF0F0F12</color>

    <color name="scrim_light">#14000000</color>
    <color name="scrim_dark">#4D000000</color>
    <color name="transparent">#00000000</color>
    <!-- Text and icons drawn on top of the generated gradient cover. -->
    <color name="on_hero">#FFFFFFFF</color>
    <color name="hero_track">#33FFFFFF</color>
    <color name="dim_overlay">#FF000000</color>
    <color name="launcher_background">#FF0F0F12</color>
</resources>
