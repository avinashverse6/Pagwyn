    <item
        android:id="@+id/action_theme"
        android:title="@string/reader_theme" />
    <item
        android:id="@+id/action_fullscreen"
        android:title="@string/reader_fullscreen" />
    <item
        android:id="@+id/action_keep_screen_on"
        android:title="@string/reader_keep_screen_on"
        android:checkable="true" />
    <item
        android:id="@+id/action_copy_text"
        android:title="@string/reader_copy_text" />
    <item
        android:id="@+id/action_share"
        android:title="@string/reader_share" />
    <item
        android:id="@+id/action_info"
        android:title="@string/reader_info" />
