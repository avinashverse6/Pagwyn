<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Test-only FileProvider so instrumented tests can hand the reader a real
      content:// URI, exactly as the Storage Access Framework does. Debug source
      sets are never part of a release build.
    -->
    <application>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.testprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/test_file_paths" />
        </provider>
    </application>
</manifest>
